METADATA_BASE_URL="http://169.254.169.254/metadata/instance/network/interface/"
URL_HDR="Metadata:true"
URL_APX='?format=text&api-version=2017-04-02'
CURL="curl -m 3 --noproxy 169.254.169.254 -s -H $URL_HDR"
LOG_CURL="logger -t cloud-netconfig -e"

# -------------------------------------------------------------------
# look up a meta data item
#
get_from_metadata()
{
    local url="${METADATA_BASE_URL}${1}${URL_APX}"
    local count=0 max_retries=${METADATA_MAX_RETRIES:-3} delay=${METADATA_RETRY_DELAY:-1} result http_code="" response_file

    response_file=$(mktemp /tmp/cn-response.XXXXXX) || return 1

    while true ; do
        http_code=""
        if result=$($CURL -D $response_file "$url" 2> >($LOG_CURL)); then
            if [[ -s "$response_file" ]]; then
                http_code=$(awk '/^HTTP/ { code=$2 } END { print code }' "$response_file")
            fi
            if [[ "$http_code" == "200" ]]; then
                rm -f "$response_file"
                echo -n "$result"
                return 0
            fi
        fi

        count=$((count+1))
        if [[ $count -gt $max_retries ]]; then
            break
        fi

        # Check if error is non-retriable: client error 4xx other than 429
        if [[ -n "$http_code" && "$http_code" =~ ^4[0-9]{2}$ && "$http_code" != "429" && "$result" != *"Too many requests"* ]]; then
            logger -t cloud-netconfig "Error: metadata server returned non-retriable status $http_code"
            test -n "$result" && logger -t cloud-netconfig "Response: $result"
            rm -f "$response_file"
            return 1
        fi

        logger -t cloud-netconfig "Warning: metadata request to $url failed (HTTP: ${http_code:-curl error}), retrying in ${delay}s (attempt $count of $max_retries)..."
        sleep "$delay"
        delay=$((delay * 2))
    done

    rm -f "$response_file"
    if [[ -n "$http_code" ]]; then
        logger -t cloud-netconfig "Error: metadata server returned $http_code after $max_retries retries"
        test -n "$result" && logger -t cloud-netconfig "Response: $result"
    else
        logger -t cloud-netconfig "Error: metadata request to $url failed after $max_retries retries"
    fi
    return 1
}


# -------------------------------------------------------------------
# get the MAC address from the metadata server
# format is uppercase without semicolons
#
get_iface_mac()
{
    local if_idx="$1"
    test -z "$if_idx" && return 1

    get_from_metadata "${if_idx}/macAddress"
    return $?
}

# -------------------------------------------------------------------
# gets all IPv4 address from the Azure metadata server for given
# interface index
#
get_ipv4_addresses_by_index()
{
    local if_idx="$1" prefixlen="${2:-}" indices ip prefix
    test -z "$if_idx" && return 1

    indices=$(get_from_metadata "${if_idx}/ipv4/ipAddress") || return 1
    test -z "$indices" && return 1

    local addrs_found=()
    for idx in $indices ; do
        ip=$(get_from_metadata "${if_idx}/ipv4/ipAddress/${idx}privateIpAddress") || return 1
        prefix=$(get_from_metadata "${if_idx}/ipv4/subnet/0/prefix") || return 1
        test -z "$ip" -o -z "$prefix" && return 1
        addrs_found+=("${ip}/${prefix}")
    done

    test ${#addrs_found[@]} -eq 0 && return 1
    echo -n "${addrs_found[*]}"
    return 0
}

# -------------------------------------------------------------------
# get IPv4 addresses from the Azure metadata server and return them
#
get_ipv4_addresses_from_metadata()
{
    local idx indices mac hwaddr="$1" iface_found=0
    test -z "$hwaddr" && return 1

    local oldopt=$(shopt -p nocasematch)
    shopt -s nocasematch
    indices=$(get_from_metadata) || { eval "$oldopt"; return 1; }
    test -z "$indices" && { eval "$oldopt"; return 1; }

    for idx in $indices ; do
        mac=$(get_iface_mac ${idx%/*}) || { eval "$oldopt"; return 1; }
        if [[ "$mac" == "${hwaddr//:/}" ]]; then
            iface_found=1
            get_ipv4_addresses_by_index ${idx%/*}
            local ret=$?
            eval "$oldopt"
            return $ret
        fi
    done
    eval "$oldopt"

    if [[ $iface_found -eq 0 ]]; then
        logger -t cloud-netconfig "Warning: interface with MAC $hwaddr not found in metadata"
        return 1
    fi
}

