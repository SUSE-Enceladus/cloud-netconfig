# -------------------------------------------------------------------
# check whether metadata server is available
# 
metadata_available()
{
    local resp retries=0 delay=${METADATA_RETRY_DELAY:-1}
    while [[ $retries -lt 3 ]]; do
        resp=$($CURL "http://169.254.169.254/metadata/instance/${URL_APX}" 2>/dev/null)
        if [[ "$resp" == *network/* ]]; then
            return 0
        fi
        retries=$((retries+1))
        sleep "$delay"
    done
    return 1
}

